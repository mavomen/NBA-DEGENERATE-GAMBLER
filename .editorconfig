# EditorConfig: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 88

[*.{yml,yaml,json}]
indent_size = 2

[*.toml]
indent_size = 4

[*.{sh,bash}]
indent_size = 4
end_of_line = lf

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{txt,csv}]
indent_size = 4

[.gitignore]
insert_final_newline = true

